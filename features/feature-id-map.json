{
  "companion-file.feature": {
    "Disable new entry when no companion file is connected": "COMP-001",
    "Prevent new entry creation from the date picker when no companion file is connected": "COMP-002"
  },
  "baseline.feature": {
    "Finishing baseline locks inputs and hides zero or unchecked symptoms": "BASE-001"
  },
  "meal-logging.feature": {
    "Add meal is disabled until baseline is complete": "MEAL-001"
  },
  "symptom-change.feature": {
    "Selecting \"no\" hides and clears post-meal symptom fields": "SYMP-001",
