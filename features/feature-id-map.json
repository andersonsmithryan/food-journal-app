  },
  "entry-selector.feature": {
    "Selecting an existing entry loads its data": "ENTR-001",
    "Changing the date creates or loads an entry": "ENTR-002"
  },
  "persistence.feature": {
    "Saving an entry writes to local storage": "PERS-001",
    "Saving an entry updates the companion file when connected": "PERS-002",
    "Importing a companion file loads entries into the journal": "PERS-003"
  },
  "timeline.feature": {
    "Adding a timeline row creates a symptom event": "TL-001",
    "Updating meal time recalculates timeline onsets": "TL-002"
  },
  "macros.feature": {
